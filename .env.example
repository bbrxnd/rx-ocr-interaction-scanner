# Runs without credentials. Options: demo, ollama, compatible
AI_PROVIDER=demo
# Optional local Ollama setup: use a model shown by ollama list.
AI_MODEL=llama3:latest
AI_BASE_URL=http://localhost:11434
# For compatible: use a trusted OpenAI-compatible server base URL ending in /v1.
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model-name
# AI_API_KEY=your-private-key
